	</ItemGroup>

	<ItemGroup>
	  <PRIResource Remove="Content\NovaPasta1\**" />
	</ItemGroup>

	<ItemGroup>
	  <Compile Remove="Content\Components\Cards\SectorCard.xaml.cs" />
	</ItemGroup>

	<ItemGroup>
	  <MauiXaml Remove="Content\Components\Cards\SectorCard.xaml" />
	</ItemGroup>

</Project>
