<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ModeratorApp.Cards.NewsCard">
    <VerticalStackLayout Spacing="10" Margin="0,20,0,0">

        <Image Source="dummyappimage.png"
               WidthRequest="500"
               HeightRequest="200"/>

        <Label 
            Text="Lançamento do novo aplicativo de gerenciamento."
            VerticalOptions="Center" 
            HorizontalOptions="Center"
            TextColor="White"
            FontAttributes="Bold"
            FontSize="18"
            HorizontalTextAlignment="Center"
            Margin="0,20,0,0"/>
        <Label 
            Text="Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum."
            VerticalOptions="Center" 
            HorizontalOptions="Center"
            TextColor="White"
            LineBreakMode="TailTruncation" 
            FontSize="15"/>

        <HorizontalStackLayout  VerticalOptions="Center" HorizontalOptions="Center" Spacing="30" Margin="0,20,0,0">
            <Button x:Name="AddEventButton"
                    BackgroundColor="#333333"
                    Text="Editar"
                    WidthRequest="150"
                    TextColor="White"
                    FontSize="15"
                    BorderWidth="2"
                    BorderColor="Green"/>
            <Button x:Name="ManageRoleButton"
                    BackgroundColor="#333333"
                    Text="Remover"
                    WidthRequest="150"
                    TextColor="White"
                    FontSize="15"
                    BorderWidth="2"
                    BorderColor="Red"/>
        </HorizontalStackLayout>

        <!-- White Line -->
        <Border BackgroundColor="White" 
                 HeightRequest="3" 
                 Grid.Row="1" 
                 HorizontalOptions="Fill" 
                 VerticalOptions="Center"
                 Stroke="White"
                 Margin="0,30,0,0">
        </Border>
    </VerticalStackLayout>
</ContentView>
