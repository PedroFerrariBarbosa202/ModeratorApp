<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ModeratorApp.Cards.UserAccountCard">
    
    <Border WidthRequest="200" 
            HeightRequest="300"
            Margin="20,20,20,20"
            BackgroundColor="#3d3d3d">
        <VerticalStackLayout Spacing="10">
            <Label x:Name="VolunteerName"
                Text="NomeDoVoluntário"
                TextColor="White"
                FontSize="16"
                FontAttributes="Bold"
                VerticalOptions="Start" 
                HorizontalOptions="Center"
                Margin="0,20,0,20"/>

            <Border WidthRequest="100"
                    HeightRequest="100"
                    Stroke="White"
                    StrokeThickness="3">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20"/>
                </Border.StrokeShape>

                <Image x:Name="UserImage"
                       Source="trash.png"
                       HorizontalOptions="Fill"
                       VerticalOptions="Fill"/>
            </Border>

            <HorizontalStackLayout Margin="0,10,0,10"
                                   VerticalOptions="Center" 
                                   HorizontalOptions="Center"
                                   Spacing="10">
                <Label
                    Text="Status: "
                    TextColor="White"
                    FontSize="14"/>
                
                <Label x:Name="StatusLabel"
                    TextColor="White"
                    FontSize="14"/>
            </HorizontalStackLayout>

            <Button Text="Ver Conta"
                    BackgroundColor="#3A3A3A"
                    TextColor="White"
                    WidthRequest="150"
                    CornerRadius="10"
                    BorderWidth="2"
                    BorderColor="Green"
                    Clicked="OnViewAccountClicked"/>
        </VerticalStackLayout>
    </Border>
</ContentView>
