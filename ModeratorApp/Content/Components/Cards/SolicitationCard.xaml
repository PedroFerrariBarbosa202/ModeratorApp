<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ModeratorApp.Cards.SolicitationCard">

    <VerticalStackLayout Spacing="30">
        <Grid ColumnDefinitions="Auto, 10, Auto, 10, Auto" RowDefinitions="*, *">
            <!-- left border (info)-->
            <Border BackgroundColor="White" 
                    WidthRequest="400" 
                    HeightRequest="200"
                    Stroke="DarkGreen"
                    StrokeThickness="3"
                    Grid.Column="0">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>

                    <Grid RowDefinitions="Auto, *">
                        <Label Margin="10,10,0,0"
                               TextColor="Black"
                               FontSize="20"
                               Grid.Row="0"
                               FontAttributes="Bold">Pedido de validação de conta:</Label>

                    <VerticalStackLayout Grid.Row="1" Margin="30,20,0,0" Spacing="10">
                        <Label TextColor="Black"
                               x:Name="Name"
                               FontSize="15">Nome:</Label>
                        <Label TextColor="Black"
                               x:Name="Email"
                               FontSize="15">Email:</Label>
                        <Label TextColor="Black"
                               x:Name="Password"
                               FontSize="15">Senha:</Label>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- middle border (tags)-->
            <Border BackgroundColor="White"  
                    WidthRequest="300" 
                    HeightRequest="200" 
                    VerticalOptions="Center"
                    Stroke="DarkGreen"
                    StrokeThickness="3"
                    Grid.Column="2">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10"/>
                </Border.StrokeShape>

                <ScrollView>
                    <VerticalStackLayout x:Name="TagStack"
                     HorizontalOptions="Center"
                     VerticalOptions="Fill">
                        <Label Margin="0,10,0,10"
                               FontSize="20"
                               FontAttributes="Bold">Setores:</Label>
                    
                    </VerticalStackLayout>
                </ScrollView>
            </Border>


            <!-- right border (buttons)-->
            <Border BackgroundColor="White"  
                    WidthRequest="250" 
                    HeightRequest="200" 
                    VerticalOptions="Center"
                    Stroke="DarkGreen"
                    StrokeThickness="3"
                    Grid.Column="4">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10"/>
                </Border.StrokeShape>

                <Grid RowDefinitions="Auto, 20, Auto" 
                          VerticalOptions="Center" 
                          WidthRequest="200">
                    <Button Text="Aceitar Validação"
                                TextColor="White"
                                Grid.Row="0" 
                                HeightRequest="60" 
                                BackgroundColor="Green"
                                Clicked="OnVerifyButtonClicked"/>
                    <Button Text="Negar Validação"
                                TextColor="White"
                                Grid.Row="2" 
                                HeightRequest="60" 
                                BackgroundColor="DarkRed"/>
                </Grid>
            </Border>
        </Grid>

        <Border BackgroundColor="White" 
                 HeightRequest="3" 
                 Grid.Row="1" 
                 HorizontalOptions="Fill" 
                 VerticalOptions="Center"
                 Stroke="White">

            <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20"/>
            </Border.StrokeShape>
        </Border>
    </VerticalStackLayout>
</ContentView>
