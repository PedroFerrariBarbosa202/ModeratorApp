<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ModeratorApp.Content.View.NewsForm"
             ZIndex="999"
             BackgroundColor="Transparent">

    <Grid BackgroundColor="#80000000"
          HorizontalOptions="Fill"
          VerticalOptions="Fill">

        <Grid HorizontalOptions="Center"
              VerticalOptions="Center"
              ColumnDefinitions="*"
              Padding="10"
              MaximumWidthRequest="800"
              MinimumWidthRequest="250">

            <Border Grid.Column="0"
                    Padding="20"
                    Stroke="White"
                    StrokeThickness="3"
                    StrokeShape="RoundRectangle 20"
                    BackgroundColor="#1C1C1C"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill">

                <ScrollView>
                    <VerticalStackLayout Spacing="10">
                        <!-- Close Button -->
                        <Button Text="X"
                                BackgroundColor="Red"
                                TextColor="White"
                                CornerRadius="20"
                                BorderColor="White"
                                BorderWidth="2"
                                WidthRequest="40"
                                HeightRequest="40"
                                HorizontalOptions="End"
                                VerticalOptions="Start"
                                Clicked="OnCloseClicked"/>

                        <VerticalStackLayout HorizontalOptions="Fill"
                                               Spacing="10"
                                               Padding="5,0">
                            <HorizontalStackLayout HorizontalOptions="Center"
                                                   Spacing="60">
                                <Label Text="Escolha uma imagem:" 
                                       VerticalOptions="Center"
                                       FontSize="20"
                                       TextColor="White"
                                       FontAttributes="Bold"/>
                                <Border Stroke="White"
                                        StrokeThickness="2"
                                        MaximumHeightRequest="300"
                                        MaximumWidthRequest="300">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10"/>
                                    </Border.StrokeShape>
                                    
                                    <ImageButton Source="imgchoose.png"
                                           x:Name="ImageChooser"
                                           Clicked="OnPickImageClicked"/>
                                </Border>
                            </HorizontalStackLayout>
                            <Entry Placeholder="Título..."
                                   x:Name="TitleEntry"
                                   TextColor="Black"
                                   BackgroundColor="#F5F5F5"/>

                            <Editor Placeholder="Conteúdo..."
                                   x:Name="ContentEntry"
                                   TextColor="Black"
                                   BackgroundColor="#F5F5F5"
                                    HeightRequest="300"/>

                            <Button Text="Adicionar"
                                    BackgroundColor="#4CAF50"
                                    TextColor="White"
                                    CornerRadius="8"
                                    MaximumWidthRequest="300"
                                    Margin="0,20,0,0"
                                    Clicked="OnAddNewsClicked"/>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </ScrollView>
            </Border>
        </Grid>
    </Grid>
</ContentView>
