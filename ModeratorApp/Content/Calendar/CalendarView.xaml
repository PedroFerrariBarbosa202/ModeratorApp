<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ModeratorApp.Content.Calendar.CalendarView">
    <VerticalStackLayout Spacing="20">
        <HorizontalStackLayout VerticalOptions="Start" 
                       HorizontalOptions="End"
                       Spacing="20"
                       Margin="0,30,30,0">
            <VerticalStackLayout>
                <Label Text="Usuário" 
               TextColor="White" 
               FontSize="15" 
               FontAttributes="Bold"/>
                <Picker x:Name="CalendarUserPicker"
                    BackgroundColor="White"
                    WidthRequest="150"
                    SelectedIndexChanged="OnLoaded"/>
            </VerticalStackLayout>

            <VerticalStackLayout>
                <Label Text="Mês" 
               TextColor="White" 
               FontSize="15" 
               FontAttributes="Bold"/>
                <DatePicker x:Name="CalendarDatePicker"
                    BackgroundColor="White"
                    WidthRequest="150"
                    Format="MMMM yyyy"
                    DateSelected="OnDateChanged"/>
            </VerticalStackLayout>
        </HorizontalStackLayout>
        
        <Label x:Name="MonthLabel"
               TextColor="White"
               FontAttributes="Bold"
               FontSize="25"
               HorizontalOptions="Start"/>
        
        <Grid x:Name="CalendarGrid"
              RowDefinitions="Auto"
              ColumnDefinitions="Auto"
              RowSpacing="5"
              ColumnSpacing="5">
        </Grid>
    </VerticalStackLayout>
</ContentView>
