<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ModeratorApp.NewsPage"
             xmlns:card="clr-namespace:ModeratorApp.Cards"
             BackgroundColor="#262626"
             Title="NewsPage">
    <ScrollView>
        <VerticalStackLayout VerticalOptions="Start" HorizontalOptions="Center" WidthRequest="500">
            <Label 
                Text="Welcome to .NET MAUI!"
                VerticalOptions="Center" 
                HorizontalOptions="Center" />

            <card:NewsCard/>
            <card:NewsCard/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>