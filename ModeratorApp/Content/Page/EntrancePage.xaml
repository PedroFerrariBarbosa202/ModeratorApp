<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ModeratorApp.EntrancePage"
             BackgroundColor="#262626"
             Title="Dashboard">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">
            <!-- TÍTULO -->
            <Label 
                Text="Bem-vindo de volta!"
                TextColor="White"
                FontSize="32"
                FontAttributes="Bold"/>

            <!-- STATUS CARD -->
            <Frame BackgroundColor="#333333"
                   CornerRadius="20"
                   Padding="20"
                   HasShadow="True">

                <VerticalStackLayout Spacing="10">
                    <Label Text="Status do Sistema"
                           TextColor="#AAAAAA"
                           FontSize="14"/>

                    <Label x:Name="SystemStatusLabel"
                           Text="🟢 Sistema Ativo"
                           TextColor="White"
                           FontSize="20"
                           FontAttributes="Bold"/>
                </VerticalStackLayout>
            </Frame>

            <!-- ESTATÍSTICAS -->
            <Grid ColumnDefinitions="*,*"
                  RowDefinitions="*, *, *, *"
                  ColumnSpacing="15"
                  RowSpacing="15">

                <Frame Grid.Row="0" Grid.Column="0"
                       BackgroundColor="#3A3A3A"
                       CornerRadius="18"
                       Padding="15">
                    <VerticalStackLayout>
                        <Label Text="Eventos Registrados:"
                               TextColor="#AAAAAA"
                               FontSize="13"/>
                        <Label x:Name="RegisteredEvents"
                               Text="Carregando..."
                               TextColor="White"
                               FontSize="24"
                               FontAttributes="Bold"/>
                    </VerticalStackLayout>
                </Frame>

                <Frame Grid.Row="0" Grid.Column="1"
                       BackgroundColor="#3A3A3A"
                       CornerRadius="18"
                       Padding="15">
                    <VerticalStackLayout>
                        <Label Text="Solicitações:"
                               TextColor="#AAAAAA"
                               FontSize="13"/>
                        <Label x:Name="Solicitations"
                               Text="Carregando..."
                               TextColor="White"
                               FontSize="24"
                               FontAttributes="Bold"/>
                    </VerticalStackLayout>
                </Frame>

                <Frame Grid.Row="1" Grid.Column="0"
                       BackgroundColor="#3A3A3A"
                       CornerRadius="18"
                       Padding="15">
                    <VerticalStackLayout>
                        <Label Text="Contas Verificadas:"
                               TextColor="#AAAAAA"
                               FontSize="13"/>
                        <Label x:Name="VerifiedAccounts"
                                        Text="Carregando"
                                       TextColor="White"
                                       FontSize="24"
                                       FontAttributes="Bold"/>
                    </VerticalStackLayout>
                </Frame>

                <Frame Grid.Row="1" Grid.Column="1"
                       BackgroundColor="#3A3A3A"
                       CornerRadius="18"
                       Padding="15">
                    <VerticalStackLayout>
                        <Label Text="Setores Disponíveis:"
                               TextColor="#AAAAAA"
                               FontSize="13"/>
                        <Label x:Name="Sectors"
                               Text="Carregando"
                               TextColor="White"
                               FontSize="24"
                               FontAttributes="Bold"/>
                    </VerticalStackLayout>
                </Frame>

                <Frame 
                       Grid.Row="3"
                       Grid.Column="0"
                       BackgroundColor="#3A3A3A"
                       CornerRadius="18"
                       Padding="15">
                    <VerticalStackLayout>
                        <Label Text="Notícias Publicadas:"
                               TextColor="#AAAAAA"
                               FontSize="13"/>
                                        <Label x:Name="News"
                               Text="Carregando"
                               TextColor="White"
                               FontSize="24"
                               FontAttributes="Bold"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Tempo Monitorado 
                <Frame Grid.Row="2" Grid.ColumnSpan="2"
                       BackgroundColor="#3A3A3A"
                       CornerRadius="18"
                       Padding="15">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Tempo Monitorado Hoje"
                               TextColor="#AAAAAA"
                               FontSize="13"/>

                        <ProgressBar Progress="0.65"
                                     HeightRequest="8"/>

                        <Label Text="65% do limite diário utilizado"
                               TextColor="#CCCCCC"
                               FontSize="12"/>
                    </VerticalStackLayout> 
                </Frame>-->
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
